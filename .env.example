# Environment variables for College Essay Edge
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Supabase — public keys (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-side only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test environment — point at a dedicated test Supabase project
# Used by src/__tests__/ai/schema.test.ts
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key

# AI Provider keys
OPENAI_API_KEY=sk-...

# Stripe (for billing domain)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
