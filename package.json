{
  "name": "college-essay-edge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "22.11.0",
    "npm": "10.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:first-minute:surface-gates": "vitest run src/__tests__/unit/page3-surface-integrity.spec.ts src/__tests__/unit/opening-coach-ordering.spec.ts src/__tests__/unit/opening-coach.spec.ts",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.types.ts",
    "eval:seed": "tsx evaluation/scripts/generate-cases.ts",
    "eval:validate": "tsx evaluation/scripts/eval-validate.ts",
    "eval:nds": "tsx evaluation/scripts/eval-nds.ts",
    "eval:baseline": "tsx evaluation/scripts/eval-baseline.ts",
    "eval:normalize": "tsx evaluation/scripts/eval-normalize.ts",
    "eval:review-packet": "tsx evaluation/scripts/eval-review-packet.ts",
    "eval:summary": "tsx evaluation/scripts/eval-summary.ts",
    "eval:full": "tsx evaluation/scripts/eval-full.ts",
    "eval:intake": "tsx evaluation/intake/eval-intake.ts",
    "eval:intake:red-team": "tsx evaluation/intake/red-team-slices.ts",
    "test:nds:realization-vs-action": "tsx scripts/verify-realization-vs-action.ts",
    "test:nds:action-dominance": "tsx scripts/nds-action-dominance-protocol.ts",
    "test:nds:evidence-grounding": "tsx scripts/nds-evidence-grounding-audit.ts",
    "test:nds:direction-line-fit": "tsx scripts/nds-direction-line-fit-audit.ts",
    "test:nds:axis-coverage": "tsx scripts/nds-axis-coverage-test.ts",
    "test:nds:meta-label-rejection": "tsx scripts/nds-meta-label-rejection-test.ts",
    "test:nds:relationship-listening": "tsx scripts/nds-relationship-listening-coverage-microtest.ts",
    "test:nds:direction-stability": "tsx scripts/nds-direction-stability-test.ts",
    "test:nds:stability-failure-diagnostic": "tsx scripts/nds-stability-failure-diagnostic.ts",
    "test:nds:stability-hardening-sprint": "tsx scripts/nds-stability-hardening-sprint-report.ts",
    "test:nds:edge-case-breaker": "tsx scripts/nds-edge-case-breaker.ts",
    "test:nds:edge-input-recovery-sprint": "tsx scripts/nds-edge-input-recovery-sprint-report.ts",
    "test:nds:edge-stability-reconciliation-sprint": "tsx scripts/nds-edge-stability-reconciliation-sprint-report.ts",
    "test:nds:release-check": "node scripts/nds-release-check.mjs",
    "test:product:screen-trust": "tsx scripts/screen-by-screen-trust-audit.ts",
    "test:product:trust-repair-sprint": "tsx scripts/product-trust-repair-sprint-report.ts",
    "test:product:flow-break": "tsx scripts/app-flow-break-test.ts",
    "test:product:flow-repair-sprint": "tsx scripts/app-flow-repair-sprint-report.ts",
    "test:product:session-state": "tsx scripts/session-and-state-integrity-test.ts",
    "test:product:real-user-sim": "tsx scripts/real-user-simulation-test.ts",
    "test:product:distribution-shift": "tsx scripts/distribution-shift-evaluation.ts",
    "test:product:distribution-shift-diagnostic": "tsx scripts/distribution-shift-failure-diagnostic.ts",
    "test:product:distribution-shift-hardening-sprint": "tsx scripts/distribution-shift-hardening-sprint.ts",
    "test:product:distribution-shift-class-repair-sprint": "tsx scripts/distribution-shift-class-repair-sprint.ts",
    "test:product:distribution-shift-pattern-diagnostic": "tsx scripts/distribution-shift-pattern-diagnostic.ts",
    "test:product:false-premium-indirect-signal-repair-sprint": "tsx scripts/false-premium-and-indirect-signal-repair-sprint.ts",
    "test:product:high-trust-risk-attribution-triage": "tsx scripts/high-trust-risk-attribution-triage.ts",
    "deploy:prod:canonical": "node scripts/deploy-prod-with-canonical-alias.mjs",
    "eval:holdout:v2:remediation": "HOLDOUT_OUT_DIR=./evaluation_outputs/page3_holdout_v2_remediation HOLDOUT_LABEL='V2 (UNTOUCHED PACKET)' node scripts/page3-holdout-v2.mjs",
    "deploy:prod:canonical:with-blind-refresh": "npm run deploy:prod:canonical && npm run eval:holdout:v2:remediation",
    "eval:page3:layer:a": "HOLDOUT_CASES_PATH=./scripts/data/frozen/page3-holdout-v2-cases.frozen.json HOLDOUT_OUT_DIR=./evaluation_outputs/page3_layers/layer_a_frozen_regression_v1 HOLDOUT_LABEL='Layer A — Frozen Regression Benchmark' node scripts/page3-holdout-v2.mjs",
    "eval:page3:layer:b": "HOLDOUT_CASES_PATH=./scripts/data/page3-unseen-v1-cases.json HOLDOUT_OUT_DIR=./evaluation_outputs/page3_layers/layer_b_unseen_validation_v1 HOLDOUT_LABEL='Layer B — Unseen Validation Set' node scripts/page3-holdout-v2.mjs",
    "eval:page3:layer:c": "HOLDOUT_CASES_PATH=./scripts/data/page3-messy-v1-cases.json HOLDOUT_OUT_DIR=./evaluation_outputs/page3_layers/layer_c_messy_realworld_v1 HOLDOUT_LABEL='Layer C — Messy Input Set' node scripts/page3-holdout-v2.mjs",
    "eval:page3:layers:v1": "node scripts/page3-multilayer-validation-v1.mjs",
    "eval:page3:rc": "node scripts/page3-release-candidate-validation.mjs",
    "eval:page3:rc:freeze": "node scripts/freeze-page3-rc-baseline.mjs",
    "eval:page3:controlled": "node scripts/page3-controlled-testing-lane.mjs",
    "verify:served:founder": "FOUNDER_CASES_PATH=./evaluation/cases/founder_served_case_pack_canonical_v1.json node scripts/founder-served-verification-canonical.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.47.0",
    "@types/pg": "^8.18.0",
    "next": "^15.1.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
